rules_version = '2';

// ============================================================================
// SECURITY NOTE — READ THIS BEFORE GOING TO PRODUCTION
// ============================================================================
// These rules allow the storefront and admin dashboard to function using only
// the public Firebase Web SDK config (no service account). The trade-off:
// anyone who knows your public apiKey (it's exposed in the page source — that
// is by design for the Web SDK) can hit Firestore directly and:
//   - read all orders (customer PII: name, email, phone, address)
//   - read your subscriber list
//   - read & write all products
//
// This is acceptable for an MVP / staging environment, NOT for production.
//
// To lock this down, switch the server side to the Firebase Admin SDK
// (service-account auth) and replace this entire file with:
//
//   service cloud.firestore {
//     match /databases/{database}/documents {
//       match /{document=**} { allow read, write: if false; }
//     }
//   }
//
// The Admin SDK bypasses these rules entirely.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // The customer, address, items and totals every order (and card checkout)
    // must carry.
    function isOrderShaped(d) {
      return
        d.customer.name is string &&
        d.customer.email is string &&
        d.customer.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        d.customer.phone is string &&
        d.shipping.address is string &&
        d.shipping.city is string &&
        d.shipping.state is string &&
        d.shipping.zip is string &&
        d.shipping.country is string &&
        d.items is list &&
        d.items.size() > 0 &&
        d.items.size() <= 50 &&
        d.subtotal is number &&
        d.subtotal >= 0 &&
        d.subtotal <= 100000 &&
        d.discountAmount is number &&
        d.discountAmount >= 0 &&
        d.discountAmount <= d.subtotal &&
        (d.promoCode is string || d.promoCode == null) &&
        d.shippingZone is string &&
        d.droppinAutoPush is bool;
    }

    // Orders: anyone can CREATE (public checkout), but reads are OPEN here so
    // the admin dashboard can compute analytics. Tighten before launch.
    match /orders/{orderId} {
      allow create: if
        isOrderShaped(request.resource.data) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasOnly([
          'customer','shipping','items','notes','subtotal','shippingFee',
          'discountAmount','promoCode',
          'shippingZone','droppinAutoPush',
          // "eg" | "us" — which storefront the order came from. Decides the
          // currency and whether it is dispatched to Droppin at all.
          'region',
          // Stock is reserved in the same transaction that creates the order,
          // so the record of what it took is written at create time, not on a
          // later approval.
          'stockDeducted',
          'currency','status','attribution','createdAt',
          // US card orders: written once Stripe confirms the payment, when a
          // paid /checkouts document becomes the order. These flags are
          // forgeable through these open rules, so treat Stripe's dashboard,
          // not this document, as the proof of payment.
          'paymentMethod','paymentStatus','stripeSessionId',
          'stripePaymentIntentId','amountPaid','paidAt'
        ]);
      allow read: if true;
      // Admin lifecycle actions (approve / deliver / cancel) and carrier
      // dispatch run through the app's server routes using the Web SDK, so they
      // need update access. Immutable fields (customer, items, totals) cannot be
      // changed; only the status, lifecycle timestamps, and droppin* shipping
      // fields may be written. Same MVP trade-off as products/settings — move
      // the admin write path to the Admin SDK before launch.
      allow update: if
        request.resource.data.customer == resource.data.customer &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.subtotal == resource.data.subtotal &&
        request.resource.data.status in ['pending','approved','delivered','cancelled','refunded'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','approvedAt','deliveredAt','cancelledAt','refundedAt','stockDeducted',
          'droppinPackageId','droppinTrackingNumber','droppinStatus',
          'droppinPushedAt','droppinError','droppinPushAttemptedAt'
        ]);
      allow delete: if false;
    }

    // Card checkouts (US store) waiting on Stripe. Created by /api/checkout in
    // the same transaction that reserves the stock; becomes an /orders document
    // with the same id once paid ('paid'), or gives its stock back when the
    // shopper walks away ('released'). Same open-rules MVP trade-off as orders.
    match /checkouts/{checkoutId} {
      allow create: if
        isOrderShaped(request.resource.data) &&
        request.resource.data.region == 'us' &&
        request.resource.data.status == 'open' &&
        request.resource.data.keys().hasOnly([
          'customer','shipping','items','notes','subtotal','shippingFee',
          'discountAmount','promoCode','shippingZone','droppinAutoPush',
          'region','stockDeducted','currency','status','attribution','createdAt'
        ]);
      allow read: if true;
      allow update: if
        request.resource.data.customer == resource.data.customer &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.subtotal == resource.data.subtotal &&
        request.resource.data.status in ['open','paid','released'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','stripeSessionId','paidAt','releasedAt','releaseReason'
        ]);
      allow delete: if false;
    }

    // Subscribers: signup is public; reads needed for broadcast list.
    match /subscribers/{email} {
      allow create, update: if
        request.resource.data.email is string &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        request.resource.data.status == 'subscribed';
      allow read: if true;
      allow delete: if false;
    }

    // Products: storefront reads, admin writes. Open writes are the main risk
    // here — anyone with the apiKey can edit your catalog. Move to Admin SDK
    // before launch.
    match /products/{handle} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Collections: same MVP trade-off as products — open writes. Tighten by
    // moving the admin write path to the Admin SDK before launch.
    match /collections/{handle} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Size charts: storefront reads assigned charts; admin writes.
    match /sizeCharts/{handle} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Promo codes: the checkout form looks codes up (via /api/promo-codes/validate
    // and the checkout API), so reads stay open like the rest of this MVP's
    // resources. Same trade-off as products/settings — move admin writes to the
    // Admin SDK before launch.
    match /promoCodes/{code} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Contact messages: public submit (validated), open reads for admin list.
    // Lock down with Admin SDK before launch to protect submitter PII.
    match /contact/{messageId} {
      allow create: if
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 2000 &&
        request.resource.data.status == 'new';
      allow read: if true;
      allow update, delete: if false;
    }

    // Store-wide settings (shipping fee, etc). MVP trade-off as above —
    // anyone with the apiKey can change settings. Tighten with Admin SDK.
    match /settings/{key} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Analytics sessions: public can create (anonymous beacon), reads open for
    // admin dashboard aggregation. MVP trade-off — tighten with Admin SDK.
    match /sessions/{sessionDoc} {
      allow create: if
        request.resource.data.keys().hasAny(['sessionId','referrer','referrerHost','socialReferrer','country','region','city','path','utm']) &&
        request.resource.data.size() < 30;
      allow read: if true;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
